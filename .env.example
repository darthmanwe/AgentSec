# AgentSec configuration example.
#
# Copy to `.env` and edit. `.env` is gitignored; this file is not.
# Every value below is a placeholder. Never put a real secret in this file.
#
# Note: UV_PROJECT_ENVIRONMENT is deliberately NOT set here. uv does not read
# .env for its own configuration, so it must be exported by your shell or task
# runner. See scripts/preflight.ps1.

# --- mode -------------------------------------------------------------------
# eval  : offline benchmark execution. Requires no credentials. The default.
# local : interactive development against local infrastructure.
# demo  : recorded demonstration. Requires AGENTSEC_ANTHROPIC_API_KEY.
AGENTSEC_MODE=eval

AGENTSEC_LOG_LEVEL=INFO

# --- infrastructure ---------------------------------------------------------
# Development credentials only. Matches docker-compose defaults.
AGENTSEC_DATABASE_URL=postgresql+asyncpg://agentsec:devonly@localhost:5432/agentsec
AGENTSEC_OPA_URL=http://localhost:8181
AGENTSEC_TEMPORAL_ADDRESS=localhost:7233
AGENTSEC_TEMPORAL_TASK_QUEUE=agentsec-main

# --- credentials ------------------------------------------------------------
# Leave unset for eval mode. Setting them is what makes a run cost money.
# AGENTSEC_ANTHROPIC_API_KEY=
# AGENTSEC_GITHUB_TOKEN=
# AGENTSEC_OPERATOR_TOKEN=

# --- models -----------------------------------------------------------------
# headline: quoted in the README, single arm only.
# bulk    : the ablation sweep. Dated snapshot, not the moving alias, so a
#           published benchmark cannot change when an alias is repointed.
AGENTSEC_MODEL_HEADLINE=claude-opus-5
AGENTSEC_MODEL_BULK=claude-haiku-4-5-20251001

# --- budget -----------------------------------------------------------------
# Hard ceiling. The accountant reserves worst-case cost before each live request
# and aborts rather than exceeding this.
AGENTSEC_BUDGET_MAX_USD=25.0
AGENTSEC_BUDGET_REQUIRE_EXPLICIT_LIVE_FLAG=true

# --- authorization ----------------------------------------------------------
# Capability TTL is bounded to 30-120s by AS-011. A grant never outlives its
# approval: effective expiry is min(now + capability_ttl, approval_expiry).
AGENTSEC_AUTHZ_CAPABILITY_TTL_SECONDS=60
AGENTSEC_AUTHZ_APPROVAL_TTL_SECONDS=900
AGENTSEC_AUTHZ_SIGNING_KEY_PATH=keys/capability_signing_ed25519.pem
AGENTSEC_AUTHZ_SIGNING_KEY_ID=dev-key-1
AGENTSEC_AUTHZ_POLICY_DECISION_TIMEOUT_SECONDS=2.0
